---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompareBar from '../components/CompareBar.astro';
import { site, type Locale } from '../config/site.ts';
import { absolute, asset } from '../i18n/routes.ts';
import { t } from '../i18n/ui.ts';
import { cardLabels } from '../lib/labels.ts';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Ruta actual (relativa al dominio). */
  path: string;
  /** Rutas equivalentes por idioma, para hreflang y el selector de idioma. */
  alternates: Partial<Record<Locale, string>>;
  noindex?: boolean;
  ogImage?: string | null;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
}

const { lang, title, description, path, alternates, noindex = false, ogImage = null, ogType = 'website', jsonLd = [] } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = absolute(path);
const image = ogImage ?? absolute(asset('/og-default.png'));
// JSON-LD: escapar "<" para impedir cierre prematuro del <script>.
const ld = jsonLd.map((o) => JSON.stringify(o).replace(/</g, '\\u003c'));
const clientStrings = {
  cardLabels: cardLabels(lang),
  cmpLimit: t(lang, 'cmp.limit'),
  cmpBar: t(lang, 'cmp.bar'),
  favorite: t(lang, 'card.favorite'),
  unfavorite: t(lang, 'card.unfavorite'),
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && alternates.es && <link rel="alternate" hreflang="es" href={absolute(alternates.es)} />}
  {!noindex && alternates.en && <link rel="alternate" hreflang="en" href={absolute(alternates.en)} />}
  {!noindex && alternates.es && <link rel="alternate" hreflang="x-default" href={absolute(alternates.es)} />}
  <meta name="theme-color" content={site.colors.bg} />
  <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:locale" content={lang === 'es' ? 'es_419' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {ld.map((json) => <script type="application/ld+json" set:html={json} />)}
</head>
<body data-lang={lang} data-base={site.basePath}>
  <a class="skip" href="#main">{t(lang, 'nav.skip')}</a>
  <Header lang={lang} alternates={alternates} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <CompareBar lang={lang} />
  <script type="application/json" id="client-i18n" set:html={JSON.stringify(clientStrings).replace(/</g, '\\u003c')} />
  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
